{
  "name": "rb-studio",
  "version": "1.0.0",
  "description": "RB Studio — photography portfolio website with Payload CMS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "cross-env SMOKE=1 vitest run"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.1",
    "@payloadcms/db-sqlite": "3.90.1",
    "@payloadcms/email-nodemailer": "3.90.1",
    "@payloadcms/email-resend": "^3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/plugin-seo": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-vercel-blob": "^3.90.1",
    "@payloadcms/ui": "3.90.1",
    "@supabase/server": "^1.8.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.6",
    "payload": "3.90.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "author": "Hamid Ehsani"
}
