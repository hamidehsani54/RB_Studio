# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Local development uses SQLite. For production use Postgres (see README).
DATABASE_URL=file:./rb-studio.db
# Public address of the website (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Random string used by the admin "Preview" button
PREVIEW_SECRET=

# Email (inquiry notifications, password reset). Without SMTP, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=hello@rbstudio.se
EMAIL_FROM_NAME=RB Studio

# Optional — used only by `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
